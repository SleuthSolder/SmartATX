# Copy this file to `secrets.yaml` and fill in real values.
# `secrets.yaml` is gitignored and must never be committed.

# --- Network -----------------------------------------------------------------
wifi_ssid: "your-network-name"
wifi_password: "your-network-password"

# Password for the fallback access point the device raises if it cannot join
# your network. Minimum 8 characters.
ap_password: "changeme-8-chars-min"

# --- Home Assistant ----------------------------------------------------------
# 32-byte base64 key for the native API. Generate one at:
#   https://esphome.io/components/api/  ("Generate encryption key")
# or:  openssl rand -base64 32
api_encryption_key: "REPLACE_WITH_A_GENERATED_BASE64_KEY"

# --- Updates -----------------------------------------------------------------
# Password required to push over-the-air updates to this device.
ota_password: "changeme"
