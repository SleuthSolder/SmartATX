# ESPHome secrets — never commit. See secrets.yaml.example for the required keys.
secrets.yaml

# ESPHome build output
.esphome/

# ESPHome Device Builder state. The Device Builder is a separate tool, not part
# of this project — if you run it with its config directory pointed here, it
# drops these files in and they should not be tracked.
.device-builder*
configs/

# Firmware artifacts
*.bin
*.elf

# Local agent/tooling scaffolding — useful on a working copy, not part of the project
.claude/
AGENTS.md
CLAUDE.md
openspec/AGENTS.md

# Editors / OS
.venv/
__pycache__/
.DS_Store
